  "item": [
    {
      "name": "System Health",
      "item": [
        {
          "name": "1. System Health Check (/health)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('System is online with active Atlas database', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('online');",
                  "    pm.expect(json.database.isConnected).to.eql(true);",
                  "    pm.expect(json.database.mode).to.eql('atlas');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"PixelKnight\",\n  \"email\": \"knight@codequest.dev\",\n  \"password\": \"AdventurePass123\",\n  \"confirmPassword\": \"AdventurePass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 or 409', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Student Login (Capture {{token}})",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrUsername\": \"coder@codequest.dev\",\n  \"password\": \"Student@CodeQuest2026\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Saved student token to collection variables');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get Current User (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
